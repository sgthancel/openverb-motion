{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // DOM, because this half of the format draws. The timing and geometry
    // modules are pure and run under Node; raster and export-video need a
    // canvas and WebCodecs, and pretending otherwise would only move the
    // failure from compile time to a host's first render.
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
